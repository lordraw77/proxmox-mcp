{
  "mcpServers": {
    "proxmox-stdio": {
      "command": "/opt/proxmox-mcp/.venv/bin/python",
      "args": ["/opt/proxmox-mcp/server.py"],
      "env": {
        "PROXMOX_MCP_TRANSPORT": "stdio"
      }
    },
    "proxmox-http": {
      "type": "http",
      "url": "http://localhost:8080/mcp"
    },
    "proxmox-sse-legacy": {
      "type": "sse",
      "url": "http://localhost:8080/sse"
    }
  }
}
